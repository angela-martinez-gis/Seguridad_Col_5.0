# --- Servidor ---
PORT=8787
NODE_ENV=development
# Origen permitido para CORS (URL de la PWA). En local: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
DB_PATH=./data/app.db
# true = la API también sirve la PWA compilada (apps/web/dist)
SERVE_WEB=false

# --- Proveedor de IA (formato compatible con OpenAI) ---
# groq | gemini | openrouter | openai | ollama | mock | none
AI_PROVIDER=mock
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Modelos de respaldo (coma) cuando el principal agota su cuota diaria
AI_MODELOS_RESPALDO=qwen/qwen3.8-27b
AI_STT_MODEL=whisper-large-v3
AI_TIMEOUT_MS=12000
AI_MAX_TOOL_CALLS=1
# Solo con AI_PROVIDER=mock: none | timeout | invalid | 429
MOCK_FAIL=none

# Análisis y transcripciones por IP cada 10 minutos (FR-023)
RATE_LIMIT_ANALISIS=20
# Resto de rutas por IP cada 10 minutos
RATE_LIMIT_GLOBAL=100

# --- Fuentes abiertas ---
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# --- Registro de casos ---
# Clave privada Ed25519 en PEM (\n escapados). Vacío = clave efímera (solo desarrollo).
CASE_SIGNING_KEY=
# Sal para anonimizar el identificador del dispositivo
OWNER_SALT=cambia-esta-sal
